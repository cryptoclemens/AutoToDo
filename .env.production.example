# =============================================================================
# AutoToDo — Production environment variables (self-hosted, staging)
# =============================================================================
# Copy to .env.production at deploy time. Never commit the filled-in version.
#
# Build-vs-runtime split:
#   - NEXT_PUBLIC_*         : inlined into the JS bundle at `npm run build`
#                             → must be present at Docker BUILD time
#   - everything else       : read at runtime → set in docker-compose env
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (self-hosted on the same VPS)
# -----------------------------------------------------------------------------
# External URL — what the BROWSER uses (token refresh, storage downloads).
# Must be HTTPS via Traefik/Let's Encrypt.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.autotodo-staging.vencly.com

# Internal URL — what the SERVER (autotodo-app container) uses.
# When set, the server-side Supabase clients should prefer this for lower latency.
# (App currently reads only NEXT_PUBLIC_SUPABASE_URL — leave both pointing to the
# external URL until we add a separate INTERNAL_SUPABASE_URL constant.)
INTERNAL_SUPABASE_URL=http://supabase-kong:8000

# JWTs signed with JWT_SECRET (anon role + service_role role).
# Generate via: ./scripts/generate-jwt-keys.sh "$JWT_SECRET"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Encryption — AES-256-GCM key for LLM API keys + transcript content
# -----------------------------------------------------------------------------
# 32 bytes hex = 64 chars. MUST match what was used to encrypt existing rows
# during pg_dump from Supabase Cloud — otherwise old keys/transcripts cannot
# be decrypted. KEEP A SECURE BACKUP.
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=

# -----------------------------------------------------------------------------
# LLM — optional fallback for free-tier users (BYOK is preferred)
# -----------------------------------------------------------------------------
FALLBACK_ANTHROPIC_KEY=

# -----------------------------------------------------------------------------
# App URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://autotodo-staging.vencly.com
NEXT_PUBLIC_APP_DOMAIN=autotodo-staging.vencly.com

# -----------------------------------------------------------------------------
# E-Mail — Resend (transactional: invitations, password reset, daily digest)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=AutoToDo <noreply@vencly.app>

# -----------------------------------------------------------------------------
# Mollie — payments
# -----------------------------------------------------------------------------
# Test key starts with test_, live key with live_.
# Webhook URL configured in Mollie dashboard:
#   https://autotodo-staging.vencly.com/api/mollie/webhook
MOLLIE_API_KEY=

# -----------------------------------------------------------------------------
# Cron — daily digest endpoint protection
# -----------------------------------------------------------------------------
# The host crontab calls /api/cron/daily-digest with `Authorization: Bearer ${CRON_SECRET}`.
# Generate with: openssl rand -hex 32
CRON_SECRET=
