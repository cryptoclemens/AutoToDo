# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption (32 Byte hex: openssl rand -hex 32)
ENCRYPTION_SECRET=your-64-char-hex-string

# LLM Fallback (optional, für Free-Tier)
FALLBACK_ANTHROPIC_KEY=sk-ant-...

# App
NEXT_PUBLIC_APP_URL=https://autotodo.vencly.com
NEXT_PUBLIC_APP_DOMAIN=autotodo.vencly.com

# E-Mail (Resend)
RESEND_API_KEY=re_...
